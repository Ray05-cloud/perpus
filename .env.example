# Neon Postgres connection string.
# Neon console -> your project -> Connect -> copy the "Pooled connection" string
# (host ends in -pooler.region.aws.neon.tech) and paste it here.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Only needed when running behind a host that assigns the port.
PORT=3000

# Only used by `npm test`. Must be a SEPARATE database from DATABASE_URL --
# the API tests drop every table before they run. See test/README.md.
# TEST_DATABASE_URL="postgresql://USER:***@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/perpus_test?sslmode=require"
